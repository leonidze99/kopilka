generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionKind {
  income
  expense

  @@map("transaction_kind")
}

/// The step of a recurring rule: every N of these from its start.
enum RecurringUnit {
  day
  week
  month

  @@map("recurring_unit")
}

enum AccountType {
  card
  cash
  savings

  @@map("account_type")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Failed sign-ins in a row; a successful one (or a password change)
  /// clears them. The throttler counts per IP, which a distributed attack
  /// on one account walks around; these count per account (login-lock.ts).
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at") @db.Timestamptz(3)
  /// Until then every sign-in is refused, the right password included.
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)

  /// Where the user is, as the browser said on registration: a background
  /// job has no request to ask, and "this month" depends on it.
  timeZone     String  @default("UTC") @map("time_zone") @db.VarChar(64)
  /// Mail when a budget is overspent; off is off for all of them.
  budgetAlerts Boolean @default(true) @map("budget_alerts")

  accounts         Account[]
  recurringRules   RecurringRule[]
  imports          Import[]
  importRules      ImportCategoryRule[]
  categories       Category[]
  transactions     Transaction[]
  refreshTokens    RefreshToken[]
  sessions         Session[]
  passwordResets   PasswordReset[]
  budgetAlertsSent BudgetAlert[]
  goals            Goal[]
  tags             Tag[]

  @@map("users")
}

/// Income or expense: a transaction gets its kind from its category.
model Category {
  id        String          @id @default(uuid(7)) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  kind      TransactionKind
  name      String          @db.VarChar(64)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringRule[]
  importRules  ImportCategoryRule[]
  alerts       BudgetAlert[]
  splits       TransactionSplit[]

  // "Подарки" may exist both as income and as expense.
  @@unique([userId, kind, name])
  // Target of the composite foreign key from transactions.
  @@unique([id, userId])
  @@map("categories")
}

/// Where the money is. The balance is not stored: it is the opening balance
/// plus the transactions, summed on read (see AccountsService), so it can
/// never drift from them.
/// SQL-only: CHECK (allow_negative OR opening_balance >= 0).
model Account {
  id             String      @id @default(uuid(7)) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  name           String      @db.VarChar(64)
  type           AccountType
  openingBalance Decimal     @default(0) @map("opening_balance") @db.Decimal(14, 2)
  /// false: no write may take the balance below zero (cash, savings).
  allowNegative  Boolean     @default(true) @map("allow_negative")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]        @relation("TransactionAccount")
  transfersIn  Transaction[]        @relation("TransferTarget")
  recurring    RecurringRule[]      @relation("RecurringAccount")
  recurringIn  RecurringRule[]      @relation("RecurringTarget")
  imports      Import[]
  goal         Goal?
  importRows   ImportRow[]          @relation("ImportRowTarget")
  importRules  ImportCategoryRule[] @relation("ImportRuleTarget")

  @@unique([userId, name])
  // Target of the composite foreign keys from transactions.
  @@unique([id, userId])
  @@map("accounts")
}

/// Income or expense (with a category, the kind comes from it) or a
/// transfer between two accounts (to_account_id, no category). A split
/// income or expense has neither: its categories are in its parts
/// (transaction_splits), which add up to its amount.
/// SQL-only: CHECK (num_nonnulls(category_id, to_account_id) <= 1),
/// CHECK (to_account_id <> account_id) and a deferred trigger checking
/// the parts (see the transaction_splits migration).
model Transaction {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  categoryId        String?   @map("category_id") @db.Uuid
  toAccountId       String?   @map("to_account_id") @db.Uuid
  amount            Decimal   @db.Decimal(14, 2)
  comment           String?   @db.VarChar(280)
  occurredAt        DateTime  @map("occurred_at") @db.Timestamptz(3)
  /// Made by a recurring rule, for its occurrence on recurring_on.
  recurringRuleId   String?   @map("recurring_rule_id") @db.Uuid
  recurringOn       DateTime? @map("recurring_on") @db.Date
  /// Brought in by an import; the fingerprint of its statement row (see
  /// ImportRow.fingerprint) keeps a second import of it out.
  importId          String?   @map("import_id") @db.Uuid
  importFingerprint String?   @map("import_fingerprint") @db.Char(64)
  /// For search: lower(comment) with ё as е. GENERATED ALWAYS in SQL (see
  /// the migration): Postgres keeps it in step on every write, whichever
  /// code path makes it, and refuses writes to it. Never set it. Prisma
  /// reads a generation expression as a default: dbgenerated() repeats it
  /// as Postgres prints it, so `migrate diff` sees no drift.
  commentSearch     String?   @default(dbgenerated("lower(translate((comment)::text, 'ёЁ'::text, 'еЕ'::text))")) @map("comment_search")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite keys: the database itself guarantees that a transaction only
  // references a category and accounts of the same user. A NULL column
  // (no category in a transfer) skips the check: MATCH SIMPLE.
  account           Account            @relation("TransactionAccount", fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  toAccount         Account?           @relation("TransferTarget", fields: [toAccountId, userId], references: [id, userId], onDelete: Restrict)
  category          Category?          @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  // The transactions stay when their rule is deleted.
  recurringRule     RecurringRule?     @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  import            Import?            @relation(fields: [importId], references: [id], onDelete: SetNull)
  similarImportRows ImportRow[]        @relation("SimilarImportRows")
  splits            TransactionSplit[]
  tags              TransactionTag[]
  receipts          Receipt[]

  // Idempotency key: one transaction per occurrence of a rule, whatever
  // retries or a second runner do.
  @@unique([recurringRuleId, recurringOn])
  // The same for statement rows: a row imported twice into one account is
  // one transaction (INSERT ... ON CONFLICT DO NOTHING).
  @@unique([accountId, importFingerprint])
  // Target of the composite foreign keys from transaction_splits and
  // transaction_tags.
  @@unique([id, userId])
  @@index([importId])
  // Trigrams: LIKE '%такс%' finds "Яндекс Такси" through the index.
  @@index([commentSearch(ops: raw("gin_trgm_ops"))], type: Gin)
  // Keyset pagination: ORDER BY occurred_at DESC, id DESC within a user.
  @@index([userId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([categoryId])
  // Balances and the account filter, from both sides of a transfer.
  @@index([accountId])
  @@index([toAccountId])
  @@map("transactions")
}

/// One category's share of a split income or expense: a receipt with
/// groceries and household goods is one payment in two categories. The
/// transaction keeps the amount that left the account (balances need
/// nothing else); totals by category count the parts instead of it.
/// One part per category (the primary key). All parts are of the
/// transaction's kind, as the service checks; that there are at least two
/// and that they add up to its amount, a deferred trigger checks at commit.
/// SQL-only: CHECK (amount > 0).
model TransactionSplit {
  transactionId String  @map("transaction_id") @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  categoryId    String  @map("category_id") @db.Uuid
  amount        Decimal @db.Decimal(14, 2)

  // Composite keys, as on transactions: a part, its transaction and its
  // category belong to one and the same user.
  transaction Transaction @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Cascade)
  // A category with parts in it is in use, as one with transactions is.
  // NO ACTION, and DEFERRABLE INITIALLY DEFERRED in the migration (Prisma
  // cannot say it): checked at commit. Deleting a user cascades to its
  // categories and, separately, through its transactions to their parts;
  // checked earlier, the category would be refused while its parts were
  // still on their way out.
  category    Category    @relation(fields: [categoryId, userId], references: [id, userId], onDelete: NoAction)

  // Leads with transaction_id: also the index for the parts of a transaction.
  @@id([transactionId, categoryId])
  // Totals and budgets of a category.
  @@index([categoryId])
  @@map("transaction_splits")
}

/// A photo of a receipt on a transaction. Kept in the database, not on
/// disk: an instance's disk does not survive a redeploy, and a row goes
/// into the backups and away with its transaction for free. Behind
/// ReceiptsService, so moving the bytes to object storage changes one file.
/// Stored as re-encoded WebP, never the upload itself: smaller, and with
/// the EXIF gone — a phone photo carries where it was taken.
/// SQL-only: CHECK (width > 0 AND height > 0).
model Receipt {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  /// Of the image, after the resize.
  width         Int
  height        Int
  /// Bytes of `image`.
  size          Int
  image         Bytes
  /// A small copy for the form: a list of them should not load megabytes.
  thumbnail     Bytes
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Composite key: a receipt is on a transaction of its own user. Goes
  // with the transaction.
  transaction Transaction @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Cascade)

  // The receipts of a transaction, in the order they came.
  @@index([transactionId, createdAt])
  @@map("receipts")
}

/// A label across categories: "Отпуск" is cafes, transport and a hotel.
/// Made on the fly by the name typed on a transaction; one tag per name
/// whatever its case or ё/е (name_key).
model Tag {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// As first typed, or as renamed.
  name      String   @db.VarChar(32)
  /// lower(name) with ё as е: what two names must differ in. GENERATED
  /// ALWAYS in SQL, as transactions.comment_search: never set it.
  nameKey   String   @default(dbgenerated("lower(translate((name)::text, 'ёЁ'::text, 'еЕ'::text))")) @map("name_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  // "Отпуск" and "отпуск" are one tag; also the index of the user's tags.
  @@unique([userId, nameKey])
  // Target of the composite foreign key from transaction_tags.
  @@unique([id, userId])
  @@map("tags")
}

/// A tag on a transaction. Goes with either of them: a tag is a label, and
/// deleting one takes it off its transactions rather than being refused.
model TransactionTag {
  transactionId String @map("transaction_id") @db.Uuid
  tagId         String @map("tag_id") @db.Uuid
  userId        String @map("user_id") @db.Uuid

  // Composite keys: a transaction is tagged only with its user's tags.
  transaction Transaction @relation(fields: [transactionId, userId], references: [id, userId], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId, userId], references: [id, userId], onDelete: Cascade)

  // Leads with transaction_id: the tags of a transaction.
  @@id([transactionId, tagId])
  // The transactions of a tag: the filter, its totals, the cascade.
  @@index([tagId])
  @@map("transaction_tags")
}

/// A monthly income, expense or transfer the server creates on its day
/// (RecurringRunner). Occurrence n falls on start_on + n months: counted
/// from the anchor, so the 31st stays the 31st (or the month's last day)
/// instead of drifting to the 28th after February. next_on/next_index point
/// at the next one; a payment is due once that day begins in time_zone.
/// SQL-only: the same CHECKs as on transactions (category or target account).
model RecurringRule {
  id          String        @id @default(uuid(7)) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  accountId   String        @map("account_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  toAccountId String?       @map("to_account_id") @db.Uuid
  amount      Decimal       @db.Decimal(14, 2)
  comment     String?       @db.VarChar(280)
  startOn     DateTime      @map("start_on") @db.Date
  /// Every `every` units after start_on. CHECK (every BETWEEN 1 AND 365)
  /// in the migration: Prisma cannot say it.
  every       Int           @default(1)
  unit        RecurringUnit @default(month)
  timeZone    String        @map("time_zone") @db.VarChar(64)
  active      Boolean       @default(true)
  nextOn      DateTime      @map("next_on") @db.Date
  nextIndex   Int           @map("next_index")
  /// Why the latest payment was skipped; cleared by the next one made.
  lastError   String?       @map("last_error") @db.VarChar(280)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // A rule is a setting: it goes away with its account or category.
  account      Account       @relation("RecurringAccount", fields: [accountId, userId], references: [id, userId], onDelete: Cascade)
  toAccount    Account?      @relation("RecurringTarget", fields: [toAccountId, userId], references: [id, userId], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  // The runner looks for active rules due by a date.
  @@index([nextOn], map: "recurring_rules_due_idx")
  @@map("recurring_rules")
}

/// A monthly spending limit of an expense category, as versions: each row
/// applies from its month until the next row of the category. Raising the
/// limit in October leaves September as it was. amount NULL: no limit from
/// that month on.
/// SQL-only: CHECK (extract(day FROM effective_from) = 1).
model Budget {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  amount        Decimal? @db.Decimal(14, 2)
  /// The first day of the month the version starts.
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // A limit dies with its category; the composite key keeps it the user's own.
  category Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade)

  // One version per month; also serves "the latest version of a category".
  @@unique([categoryId, effectiveFrom])
  @@index([userId])
  @@map("budgets")
}

/// Saving up for something on one account. What is saved is the balance of
/// that account, not a number of its own: money put aside and then spent is
/// gone from the goal too, with nothing to keep in step.
/// SQL-only: CHECK (target_amount > 0).
model Goal {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  name         String    @db.VarChar(64)
  targetAmount Decimal   @map("target_amount") @db.Decimal(14, 2)
  /// When it should be reached; without it the goal has no deadline.
  targetDate   DateTime? @map("target_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Goes with the account it counts; the composite key keeps it the user's.
  account Account @relation(fields: [accountId, userId], references: [id, userId], onDelete: Cascade)

  // One goal per account: the balance can only stand for one of them.
  // The pair rather than the column alone is also what the composite
  // foreign key above needs to be one-to-one.
  @@unique([accountId, userId])
  @@index([userId])
  @@map("goals")
}

/// A budget overspend already mailed about. One row per category and month
/// is what keeps the job from writing every hour: the unique index is the
/// idempotency key, not a flag the job sets and reads.
model BudgetAlert {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  /// The first day of the month it is about.
  month      DateTime @db.Date
  /// What the numbers were when the letter went out.
  spent      Decimal  @db.Decimal(14, 2)
  limit      Decimal  @db.Decimal(14, 2)
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([categoryId, month])
  @@index([userId])
  @@map("budget_alerts")
}

enum ImportStatus {
  /// The file is still arriving; an import stuck here was cut off.
  uploading
  /// Rows are staged; waiting for the columns and the account.
  uploaded
  /// The worker reads the rows with the chosen columns.
  parsing
  /// Parsed: waiting for the categories and the go-ahead.
  ready
  /// The worker creates the transactions.
  importing
  done
  failed
  /// Its transactions deleted again (undo); the file may be imported anew.
  undone

  @@map("import_status")
}

enum ImportRowStatus {
  /// Becomes a transaction on import.
  new
  /// Already imported into the account (same fingerprint).
  duplicate
  /// Could not be read: see error.
  invalid
  /// Readable, but not a transaction to import (a declined payment, zero).
  skipped
  /// Made into a transaction, or found imported meanwhile.
  imported

  @@map("import_row_status")
}

/// A bank statement on its way in: uploaded, read with the columns the user
/// chose, then turned into transactions by ImportWorker. The work is queued
/// in this table: the worker claims a row in a "parsing" or "importing"
/// status with a lease (locked_until) and keeps renewing it; a worker that
/// dies lets the lease expire and another one picks the import up.
model Import {
  id            String       @id @default(uuid(7)) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  /// Chosen with the columns; NULL until then.
  accountId     String?      @map("account_id") @db.Uuid
  fileName      String       @map("file_name") @db.VarChar(255)
  status        ImportStatus
  /// The header row of the file.
  headers       String[]
  /// Bank format recognised by the headers, e.g. "tbank".
  preset        String?      @db.VarChar(32)
  /// Which column holds what (ImportColumns in @kopilka/shared).
  columns       Json?
  /// The zone of the statement's local times.
  timeZone      String?      @map("time_zone") @db.VarChar(64)
  /// Data rows staged (without the header).
  totalRows     Int          @default(0) @map("total_rows")
  /// Rows done in the current phase: progress for the client.
  processed     Int          @default(0)
  newRows       Int          @default(0) @map("new_rows")
  duplicateRows Int          @default(0) @map("duplicate_rows")
  invalidRows   Int          @default(0) @map("invalid_rows")
  skippedRows   Int          @default(0) @map("skipped_rows")
  importedRows  Int          @default(0) @map("imported_rows")
  /// Transactions deleted by the undo (some may have been deleted by hand).
  undoneRows    Int          @default(0) @map("undone_rows")
  /// Why the import failed, for the user.
  error         String?      @db.VarChar(280)
  /// Lease of the worker processing it; expired = free to take over.
  lockedUntil   DateTime?    @map("locked_until") @db.Timestamptz(3)
  /// Claims in the current phase: an import that keeps crashing its
  /// worker fails after a few instead of being retried forever.
  attempts      Int          @default(0)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account?      @relation(fields: [accountId, userId], references: [id, userId], onDelete: Cascade)
  rows         ImportRow[]
  transactions Transaction[]

  @@index([userId, createdAt(sort: Desc)])
  // The worker looks for imports in a phase it runs.
  @@index([status])
  @@map("imports")
}

/// One data row of an uploaded statement: a staging table. The raw cells
/// come in during the upload; the worker fills in the parsed values. Kept
/// in the database rather than on disk: any instance can pick the work up,
/// and an instance's disk does not survive a redeploy.
/// No foreign key on category_id: a scratch value, checked when the
/// transactions are created (their own foreign key).
model ImportRow {
  importId             String           @map("import_id") @db.Uuid
  /// Line number in the file, the header being line 1: what the user sees
  /// in a spreadsheet.
  line                 Int
  cells                String[]
  /// NULL: not parsed yet.
  status               ImportRowStatus?
  /// Date and time as written in the statement, no zone: the fingerprint
  /// does not change with the zone the user picks.
  localAt              DateTime?        @map("local_at") @db.Timestamp(0)
  occurredAt           DateTime?        @map("occurred_at") @db.Timestamptz(3)
  amount               Decimal?         @db.Decimal(14, 2)
  kind                 TransactionKind?
  description          String?          @db.VarChar(280)
  /// The bank's category, '' if none: what the user maps to a category.
  sourceCategory       String?          @map("source_category") @db.VarChar(64)
  categoryId           String?          @map("category_id") @db.Uuid
  /// Chosen instead of a category: the row is a transfer between the user's
  /// own accounts, this being the other side of it.
  toAccountId          String?          @map("to_account_id") @db.Uuid
  fingerprint          String?          @db.Char(64)
  error                String?          @db.VarChar(280)
  /// A transaction entered by hand (or by a recurring rule) that looks like
  /// this row: same account, direction and amount, a day or two apart.
  /// Shown as a possible duplicate; the user decides.
  similarTransactionId String?          @map("similar_transaction_id") @db.Uuid

  import             Import       @relation(fields: [importId], references: [id], onDelete: Cascade)
  similarTransaction Transaction? @relation("SimilarImportRows", fields: [similarTransactionId], references: [id], onDelete: SetNull)
  toAccount          Account?     @relation("ImportRowTarget", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@id([importId, line])
  // Deleting a transaction looks up the rows pointing at it (ON DELETE SET
  // NULL): without an index, a scan of import_rows per deleted transaction,
  // and an undo deletes thousands at once.
  @@index([similarTransactionId])
  // The same for deleting an account (ON DELETE CASCADE).
  @@index([toAccountId])
  @@map("import_rows")
}

/// "The bank's Супермаркеты is my Продукты": remembered from the last
/// import, suggested on the next one.
model ImportCategoryRule {
  id          String          @id @default(uuid(7)) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  kind        TransactionKind
  /// The bank's category name, '' for rows without one.
  source      String          @db.VarChar(64)
  /// What rows of this bank category become: a category, or a transfer to
  /// toAccountId. Exactly one of the two, by a CHECK in the migration.
  categoryId  String?         @map("category_id") @db.Uuid
  toAccountId String?         @map("to_account_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Forgotten with its category or account.
  category  Category? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Cascade)
  toAccount Account?  @relation("ImportRuleTarget", fields: [toAccountId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, kind, source])
  @@index([categoryId])
  @@index([toAccountId])
  @@map("import_category_rules")
}

/// A signed-in device: one login, kept alive by refresh tokens. The access
/// token carries its id (sid) and JwtAuthGuard checks it on every request,
/// so ending a session takes effect at once, not when the token expires.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// As the browser sent it at the last sign-in or refresh.
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The last refresh: about every 15 minutes while the app is open.
  lastUsedAt DateTime  @map("last_used_at") @db.Timestamptz(3)
  /// When its newest refresh token expires: the session dies with it.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Ended: signed out, ended from another device, a password change, or a
  /// stolen refresh token presented. The one source of truth for that.
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

/// Opaque refresh tokens; only a SHA-256 hash is stored, never the token itself.
/// Every login starts a session (family_id); each refresh rotates the token
/// within it. revoked_at here means used: presenting a used token means it
/// was stolen, and the whole session is ended.
/// A one-time link mailed to someone who cannot sign in. Only the SHA-256
/// of the token is stored, as for refresh tokens: a leaked database does not
/// hand out account takeovers. A request invalidates the user's earlier
/// links, and using one ends every session of that user.
model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Spent: the password was changed with it.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Used by a rotation (exchanged for the next token).
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}
