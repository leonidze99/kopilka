generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionKind {
  income
  expense

  @@map("transaction_kind")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories    Category[]
  transactions  Transaction[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Income or expense: a transaction gets its kind from its category.
model Category {
  id        String          @id @default(uuid(7)) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  kind      TransactionKind
  name      String          @db.VarChar(64)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  // "Подарки" may exist both as income and as expense.
  @@unique([userId, kind, name])
  // Target of the composite foreign key from transactions.
  @@unique([id, userId])
  @@map("categories")
}

model Transaction {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  amount     Decimal  @db.Decimal(14, 2)
  comment    String?  @db.VarChar(280)
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite key: the database itself guarantees that a transaction
  // only references a category of the same user.
  category Category @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)

  // Keyset pagination: ORDER BY occurred_at DESC, id DESC within a user.
  @@index([userId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([categoryId])
  @@map("transactions")
}

/// Opaque refresh tokens; only a SHA-256 hash is stored, never the token itself.
/// Every login starts a family; each refresh rotates the token within it.
/// Presenting an already rotated token means it was stolen: the whole family is revoked.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}
