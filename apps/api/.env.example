NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://kopilka:kopilka@localhost:5432/kopilka
# fatal | error | warn | info | debug | trace | silent
# Default: debug in development, silent in test, info in production
# LOG_LEVEL=info

# At least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30

# Account lockout: failed sign-ins in a row that lock an account, and the
# first lock in minutes (it doubles with each further failure, up to an hour)
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCK_MINUTES=5

# Password reset links: how long a link works
# PASSWORD_RESET_TTL_MINUTES=60

# Where the app is for someone clicking a link in an email. In production
# this must be the public address (the API serves the frontend itself).
# APP_URL=http://localhost:5173

# SMTP of any provider, e.g. smtps://resend:re_123@smtp.resend.com:465
# Unset: mail is written to the log instead of being sent (development).
# MAIL_SMTP_URL=
# MAIL_FROM=Копилка <no-reply@kopilka.local>

# Bank of Russia XML service: exchange rates of the account currencies
# CBR_URL=https://www.cbr.ru/scripts

# Comma-separated browser origins allowed by CORS (no trailing slash).
# Not needed by the web app: Vite proxies /api, production serves it.
# CORS_ORIGINS=http://localhost:5173

# Bearer token a Prometheus scraper must send to GET /api/metrics.
# Unset: open in development, absent in production (404).
# METRICS_TOKEN=

# Background jobs (recurring payments, imports); off in e2e tests
# JOBS_ENABLED=true

# Built web app to serve from the API process (the Docker image sets it)
# WEB_DIST_DIR=../web/dist

# Reverse proxies in front of the app (Railway/Fly.io router = 1). 0 = none.
# TRUST_PROXY_HOPS=0
