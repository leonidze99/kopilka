NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://kopilka:kopilka@localhost:5432/kopilka
# fatal | error | warn | info | debug | trace | silent
# Default: debug in development, silent in test, info in production
# LOG_LEVEL=info

# At least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed by CORS (no trailing slash).
# Not needed by the web app: Vite proxies /api, production serves it.
# CORS_ORIGINS=http://localhost:5173

# Background jobs (recurring payments), every minute; off in e2e tests
# JOBS_ENABLED=true

# Built web app to serve from the API process (the Docker image sets it)
# WEB_DIST_DIR=../web/dist

# Reverse proxies in front of the app (Railway/Fly.io router = 1). 0 = none.
# TRUST_PROXY_HOPS=0
