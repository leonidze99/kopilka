{
  "name": "kopilka",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prod:up": "docker compose --profile prod up --build migrate app",
    "prod:down": "docker compose --profile prod stop migrate app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio",
    "api:generate": "pnpm --filter api openapi:generate && pnpm --filter web api:types"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^6.0.2"
  }
}
